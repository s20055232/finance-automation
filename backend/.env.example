# Claude API
ANTHROPIC_API_KEY=sk-ant-your-key-here

# AI Model (claude-sonnet-4-6 for accuracy, claude-haiku-4-5 for high volume)
AI_MODEL=claude-sonnet-4-6

# Ollama 本地 LLM（優先於 Claude；留空 = 停用）
# 先 pull model：ollama pull gemma4:e2b
# Docker 裡連本機 Ollama 要用 host.docker.internal
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# NVIDIA NIM（OLLAMA_MODEL 未設定時才生效）
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash

# Email Alerts
EMAIL_DRY_RUN=true
ALERT_EMAIL_TO=finance@yourcompany.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=alerts@yourcompany.com
SMTP_PASSWORD=your_app_password_here

# Ory Kratos secrets（生產環境必須換成隨機 32 字元字串）
# 產生方式：python3 -c "import secrets; print(secrets.token_hex(16))"
KRATOS_SECRET_COOKIE=DEV-SECRET-COOKIE-CHANGE-IN-PROD
KRATOS_SECRET_CIPHER=DEV-SECRET-CIPHER-CHANGE-IN-PROD

# Odoo XML-RPC 整合（本機 Docker 預設值）
# ODOO_API_KEY 必須在 Odoo 介面手動產生：
#   Settings → Users & Companies → Users → (你的帳號) → API Keys → New API Key
# 留空 = 自動跳過 Odoo 來源，只跑 PDF pipeline
# Docker 環境用 http://odoo:8069；本機直接跑用 http://localhost:8069
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USER=admin
ODOO_API_KEY=

# Object Storage
STORAGE_BACKEND=local
# AWS_BUCKET=your-bucket
# AWS_REGION=ap-northeast-1

# Thresholds
LARGE_AMOUNT_THRESHOLD=10000
DUPLICATE_WINDOW_DAYS=30